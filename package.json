{
  "name": "gakumas-produce-memory-deck",
  "version": "0.1.0",
  "description": "ブラウザ内保存のプロデュースメモリー管理帳",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run validate:master && tsc --noEmit && vite build",
    "validate:master": "bun scripts/validate-memory-master.ts",
    "fonts:build": "uv run --locked scripts/build-heading-font.py",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts tests vite.config.ts vitest.config.ts playwright.config.ts package.json tsconfig.json components.json index.html",
    "format:check": "prettier --check src scripts tests vite.config.ts vitest.config.ts playwright.config.ts package.json tsconfig.json components.json index.html",
    "check": "bun run typecheck && bun run test && bun run build"
  },
  "private": true,
  "packageManager": "bun@1.3.6",
  "trustedDependencies": [],
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource/zen-maru-gothic": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.3",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@textlint-ja/textlint-rule-preset-ai-writing": "^1.6.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "markdownlint-cli2": "^0.18.1",
    "prettier": "^3.9.8",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "textlint": "^15.3.0",
    "textlint-rule-ja-space-between-half-and-full-width": "^2.4.2",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
